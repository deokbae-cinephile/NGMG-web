{
  "name": "ngmg-web",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./e2e/demo-setup.ts"
  ],
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/spa-pages.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo && node scripts/spa-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test install-shots --workers=1",
    "demo": "node e2e/demo.ts"
  },
  "dependencies": {
    "@fontsource/nanum-gothic": "5.3.0",
    "@supabase/postgrest-js": "2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  }
}
