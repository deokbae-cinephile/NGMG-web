{
  "name": "ngmg-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --test supabase/tests/rls.test.mjs",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test readme-shots --workers=1",
    "demo": "node e2e/demo.ts"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "date-fns": "^4.4.0",
    "js-cookie": "^3.0.8",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
