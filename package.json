{
  "name": "ngmg-web",
  "version": "1.25.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "build:demo": "tsc --noEmit && vite build --mode demo && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "shots": "SHOTS=1 playwright test install-shots --workers=1",
    "demo": "node e2e/demo.ts"
  },
  "dependencies": {
    "@fontsource/do-hyeon": "^5.3.0",
    "@supabase/auth-js": "2.119.0",
    "@supabase/postgrest-js": "2.119.0",
    "@supabase/storage-js": "2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
