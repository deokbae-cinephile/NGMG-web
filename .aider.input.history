# 2026-11-19 18:42:12.643445
+cat << 'EOF' >> ~/.zshrc
+
+# 완성본 한 번에 출력 (--no-stream) + 추론 길이 최소화 최종판
+aider-local() {
+  lms server start
+  if ! lms ps | grep -q "qwen3.8-27b-mlx"; then
+    lms load "qwen3.8-27b-mlx" --context-length 32768 --yes
+  fi
+  OPENAI_API_BASE="http://localhost:1234/v1" \
+  OPENAI_API_KEY="lm-studio" \
+  aider --model openai/qwen3.8-27b-mlx \
+        --no-stream \
+        --no-auto-commits \
+        --no-show-model-warnings \
+        --reasoning-effort low \
+        --read ~/dev-standards/web-standards-accessibility.md "$@"
+}
+EOF
+source ~/.zshrc && aider-

